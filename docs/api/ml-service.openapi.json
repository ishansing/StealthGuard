{
  "openapi": "3.1.0",
  "info": {
    "title": "StealthGuard ML Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/model/version": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Model Version",
        "operationId": "model_version_model_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelVersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/score": {
      "post": {
        "tags": [
          "scoring"
        ],
        "summary": "Score",
        "operationId": "score_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "loaded_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loaded At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_version"
        ],
        "title": "HealthResponse"
      },
      "ModelVersionResponse": {
        "properties": {
          "active": {
            "type": "string",
            "title": "Active"
          },
          "shadow": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shadow"
          }
        },
        "type": "object",
        "required": [
          "active"
        ],
        "title": "ModelVersionResponse"
      },
      "ReasonCode": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "code",
          "weight"
        ],
        "title": "ReasonCode"
      },
      "ScoreRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "features"
        ],
        "title": "ScoreRequest"
      },
      "ScoreResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "humanness_score": {
            "type": "number",
            "title": "Humanness Score"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "reason_codes": {
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "type": "array",
            "title": "Reason Codes"
          },
          "debug": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Debug"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "humanness_score",
          "label",
          "model_version",
          "reason_codes",
          "debug"
        ],
        "title": "ScoreResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}