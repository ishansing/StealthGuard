# Copy to `.env` and adjust. All values are consumed by `docker-compose.yml` / the Makefile.

# ---- Postgres (db) ----
POSTGRES_USER=stealthguard
POSTGRES_PASSWORD=stealthguard_dev
POSTGRES_DB=stealthguard
# Default 7-day raw-telemetry retention window (documented in PRIVACY.md)
TELEMETRY_RETENTION_DAYS=7

# ---- Java gateway ----
# URL of the Python ML service as seen from inside the compose network
ML_SERVICE_URL=http://ml-service:8000
# Per-request timeout when calling the ML service
ML_TIMEOUT=2s
# Decision thresholds (§8.1): score >= HUMAN_ALLOW -> allow; score <= BOT_BLOCK -> block; else challenge
HUMAN_ALLOW_THRESHOLD=0.8
BOT_BLOCK_THRESHOLD=0.4
# Enable per-session HMAC telemetry signing (Stretch, §10)
HMAC_ENABLED=false
# Max events allowed in any single telemetry array (abuse guard)
MAX_EVENTS_PER_ARRAY=5000
# Expected answer for the accessible fallback challenge ("what is 2+2")
CHALLENGE_ANSWER=4
LOG_LEVEL=INFO

# ---- Python ML service ----
MODEL_DIR=/app/models
HUMAN_THRESHOLD=0.8
BOT_THRESHOLD=0.4
# Optional shadow model version (Stretch, §9.5); leave unset to disable
# MODEL_VERSION_SHADOW=

# ---- Frontend ----
# URL of the Java gateway as seen from the browser (Vite dev proxy target)
VITE_GATEWAY_URL=http://localhost:8080