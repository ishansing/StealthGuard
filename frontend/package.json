{
  "name": "stealthguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/demo && bun run dev",
    "dev:admin": "cd apps/admin && bun run dev",
    "dev:sandbox": "cd apps/sandbox && bun run dev",
    "build": "cd apps/demo && bun run build",
    "build:admin": "cd apps/admin && bun run build",
    "build:sandbox": "cd apps/sandbox && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint apps packages && ./scripts/check-shared-ui.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
