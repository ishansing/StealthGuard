{
  "name": "@stealthguard/ui",
  "version": "0.1.0",
  "description": "StealthGuard shared UI primitives: canonical Button, IconButton, LinkButton",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "@types/react": "^19.2.18"
  }
}
